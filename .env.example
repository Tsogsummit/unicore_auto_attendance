# UNiCORE Credentials
UNICORE_LOGIN=your_email_or_phone@example.com
UNICORE_PASSWORD=your_password_here

# Timezone & Schedule Configuration
TIMEZONE=Asia/Ulaanbaatar
CHECKIN_START_TIME=08:30
CHECKIN_END_TIME=08:50
CHECKOUT_START_TIME=16:10
CHECKOUT_END_TIME=16:30
SKIP_WEEKENDS=true

# GPS Coordinates (Default: Tselmeg Digital International School)
CENTER_LATITUDE=47.896883
CENTER_LONGITUDE=106.889669
MAX_DISTANCE_METERS=200.0
LOCATION_NAME=Tselmeg Digital International School

# Optional Webhook Notifications
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
