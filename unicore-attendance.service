[Unit]
Description=UNiCORE Automated Attendance Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/unicore_auto_attendance
ExecStart=/usr/bin/python3 /home/ec2-user/unicore_auto_attendance/main.py daemon
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
